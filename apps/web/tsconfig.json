{
  "extends": "../../packages/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/components/ui/*": [
        "../../packages/ui/src/components/ui/*"
      ],
      "@lifeos/ui": [
        "../../packages/ui/src"
      ],
      "@lifeos/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@lifeos/shared": [
        "../../packages/shared/src"
      ],
      "@lifeos/shared/*": [
        "../../packages/shared/src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "src",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
