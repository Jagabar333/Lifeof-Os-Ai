# ============================================================
# LifeOS AI - Environment Variables Template
# ============================================================
# DO NOT ADD SECRETS TO THIS FILE
# Copy this file to .env.local and fill in the values.

# ------------------------------------------------------------
# Database (MongoDB Atlas)
# ------------------------------------------------------------
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/lifeos"
MONGODB_DB_NAME="lifeos"

# ------------------------------------------------------------
# Authentication Secrets (JWT)
# ------------------------------------------------------------
JWT_SECRET="your-secure-jwt-secret-min-32-chars"
JWT_REFRESH_SECRET="your-secure-jwt-refresh-secret-min-32-chars"
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"

# ------------------------------------------------------------
# Backend & API Config
# ------------------------------------------------------------
BACKEND_API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------
# AI Providers
# ------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"

# ------------------------------------------------------------
# OAuth Providers
# ------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
